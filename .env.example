# =====================================================================================
# JARVIS backend configuration. Copy to `.env` (git-ignored) and fill in.
#
#   python scripts/dev/create_local_env.py     # creates .env and generates every secret
#   python -m jarvis_backend init-secrets      # (alternative) generate secrets into .env
#   python -m jarvis_backend check-config      # validates this file, prints no secrets
#
# This file contains NO real secrets and is safe to commit. `.env` is not.
# Real environment variables and /run/secrets files override anything here.
# Comments are on their own lines on purpose: Docker --env-file does not strip inline ones.
# =====================================================================================

# ---- runtime ------------------------------------------------------------------------
# dev | prod. prod REFUSES to start on weak/missing config (see check-config).
JARVIS_ENV=dev
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8077
JARVIS_LOG_LEVEL=INFO
# text (humans) | json (log pipelines / Docker)
JARVIS_LOG_FORMAT=text
# Where the SQLite file and logs live. Default: ~/.jarvis
# JARVIS_DATA_DIR=
# IANA zone for cron jobs, e.g. Europe/London. Empty = this machine's zone.
# JARVIS_TIMEZONE=

# ---- secrets (generated for you; keep out of git and out of chat/screenshots) --------
# Signs login tokens. >= 32 random chars. Rotating it signs everyone out.
JARVIS_JWT_SECRET=
# Old signing secret(s) still accepted for VERIFICATION while you rotate the signing secret.
# JARVIS_JWT_PREVIOUS_SECRETS=
# Encrypts conversations/memories/approvals at rest (Fernet key; comma-separate to rotate,
# newest first). BACK THIS UP: without it, encrypted data cannot be recovered.
JARVIS_DATA_KEY=
# Bearer token Prometheus uses to scrape /metrics (>= 24 chars in prod).
JARVIS_METRICS_TOKEN=

# ---- database -----------------------------------------------------------------------
# Leave empty for a local SQLite file. Production: PostgreSQL, e.g.
#   postgresql+asyncpg://jarvis:PASSWORD@db-host:5432/jarvis
JARVIS_DATABASE_URL=
# disable | prefer | require | verify-ca | verify-full. Use verify-full for any remote DB.
JARVIS_DATABASE_SSL=prefer
JARVIS_DATABASE_CA_FILE=
# JARVIS_DB_POOL_SIZE=10
# JARVIS_DB_MAX_OVERFLOW=20

# ---- redis (cache, rate limits, session revocation, cross-replica events) -------------
# Empty = in-process (single replica). Production: rediss:// (TLS) with a password, e.g.
#   rediss://:PASSWORD@redis-host:6380/0
JARVIS_REDIS_URL=

# ---- network exposure ---------------------------------------------------------------
# Host header names the server answers to. prod: your real host name(s).
JARVIS_ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origin of the dashboard. prod: https://jarvis.example.com
JARVIS_PUBLIC_ORIGIN=http://localhost:8077
# Reverse proxies in front whose X-Forwarded-For is trusted: 1 behind nginx, otherwise 0.
JARVIS_TRUSTED_PROXY_HOPS=0
# Empty = Secure cookies in prod only. Set true/false to force.
# JARVIS_COOKIE_SECURE=

# ---- auth and limits (defaults shown; uncomment to change) ---------------------------
# JARVIS_ACCESS_TOKEN_MINUTES=15
# JARVIS_REFRESH_TOKEN_DAYS=7
# JARVIS_LOGIN_ATTEMPTS_PER_WINDOW=5
# JARVIS_LOGIN_WINDOW_SECONDS=900
# JARVIS_ASSIST_PER_MINUTE=60
# JARVIS_TURN_RETENTION_DAYS=30
# JARVIS_APPROVAL_TTL_SECONDS=900

# ---- AI models (Hugging Face Inference Providers) -------------------------------------
# Fine-grained token with the "Make calls to Inference Providers" permission.
# Empty = AI off: agents keep working in their honest rule-based mode.
JARVIS_HF_TOKEN=
# JARVIS_LLM_BASE_URL=https://router.huggingface.co/v1
# Model roles. ":fastest" / ":cheapest" / ":groq" etc. pick the serving provider.
# JARVIS_LLM_MODEL_FAST=Qwen/Qwen3-8B:fastest
# JARVIS_LLM_MODEL_DEFAULT=openai/gpt-oss-120b:fastest
# JARVIS_LLM_MODEL_REASONING=openai/gpt-oss-120b:fastest
# JARVIS_LLM_DAILY_TOKEN_LIMIT=300000
# JARVIS_LLM_MAX_TOKENS=800
# JARVIS_LLM_MAX_STEPS=5
# JARVIS_LLM_TIMEOUT_SECONDS=40

# ---- observability ------------------------------------------------------------------
# JARVIS_METRICS_ENABLED=true

# ---- scheduler ----------------------------------------------------------------------
# true: this process runs cron jobs (single-process dev). Set false on API replicas and run
# `python -m jarvis_backend worker` as the ONE scheduler.
JARVIS_RUN_SCHEDULER=true

# Running with Docker? Settings live in docker/.env.docker and passwords in ./secrets/ instead.
# See docs/DOCKER_WINDOWS.md. This file is for running the backend directly on your machine.
