# =====================================================================================
# JARVIS backend configuration. Copy to `.env` (git-ignored) and fill in.
#
#   python -m jarvis_backend init-secrets     # generates every secret below for you
#   python -m jarvis_backend check-config     # validates this file, prints no secrets
#
# This file contains NO real secrets and is safe to commit. `.env` is not.
# Real environment variables and /run/secrets files override anything here.
# =====================================================================================

# ---- runtime ------------------------------------------------------------------------
JARVIS_ENV=dev                      # dev | prod. prod REFUSES to start on weak/missing config
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8077
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_FORMAT=text              # text (humans) | json (log pipelines / Docker)

# ---- secrets (generated by init-secrets; keep out of git and out of chat/screenshots) ---
# Signs login tokens. >= 32 random chars. Rotating it signs everyone out.
JARVIS_JWT_SECRET=
# Encrypts conversations/memories/approvals at rest (Fernet key; comma-separate to rotate,
# newest first). BACK THIS UP: without it, encrypted data cannot be recovered.
JARVIS_DATA_KEY=
# Bearer token Prometheus uses to scrape /metrics.
JARVIS_METRICS_TOKEN=

# ---- database -----------------------------------------------------------------------
# Leave empty for a local SQLite file. Production: PostgreSQL.
#   JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:PASSWORD@db-host:5432/jarvis
JARVIS_DATABASE_URL=
# disable | prefer | require | verify-ca | verify-full.  Use verify-full for any remote DB.
JARVIS_DATABASE_SSL=prefer
JARVIS_DATABASE_CA_FILE=

# ---- redis (cache, rate limits, session revocation, cross-replica events) --------------
# Empty = in-process (single replica). Production: rediss:// (TLS) with a password.
#   JARVIS_REDIS_URL=rediss://:PASSWORD@redis-host:6380/0
JARVIS_REDIS_URL=

# ---- network exposure ---------------------------------------------------------------
JARVIS_ALLOWED_HOSTS=localhost,127.0.0.1    # prod: your real host name(s)
JARVIS_PUBLIC_ORIGIN=                       # prod: https://jarvis.example.com
JARVIS_TRUSTED_PROXY_HOPS=0                 # 1 when behind nginx; 0 otherwise

# ---- multi-factor auth (TOTP) + step-up re-auth -------------------------------------
# MFA is opt-in per admin (enroll in the dashboard or `enroll-mfa`). These are NOT secrets.
JARVIS_MFA_ISSUER=JARVIS                     # name shown in the authenticator app
JARVIS_MFA_RECOVERY_CODES=10                 # one-time recovery codes generated at enablement
JARVIS_STEP_UP_WINDOW_SECONDS=300            # how long a step-up proof stays fresh for grants
JARVIS_APPROVAL_REQUIRE_MFA=false            # true: high-risk grants require the admin to have MFA
JARVIS_APPROVAL_STEP_UP_RISK=DANGEROUS       # DANGEROUS | RESTRICTED: lowest risk that forces step-up

# ---- llm (reasoning agents: VISION / DR. STRANGE / QUICKSILVER / NICK FURY) -----------
# Default `echo` is a deterministic offline provider (no network, no key) used in dev/tests.
# Switch to an OpenAI-compatible endpoint for real answers. A non-echo provider with an
# empty base URL safely falls back to echo. On a model/network error the agent speaks an
# honest fallback -- a provider failure never crashes an /assist request.
JARVIS_LLM_PROVIDER=echo            # echo | openai | ollama
JARVIS_LLM_MODEL=gpt-4o-mini        # OpenAI: gpt-4o-mini  ·  Ollama: e.g. llama3.1
# OpenAI: https://api.openai.com/v1   ·   local Ollama: http://localhost:11434/v1
JARVIS_LLM_BASE_URL=
# Required for OpenAI; leave empty for a local Ollama server.
JARVIS_LLM_API_KEY=
JARVIS_LLM_TIMEOUT_SECONDS=30
JARVIS_LLM_MAX_TOKENS=512

# ---- routing (which agent answers) ---------------------------------------------------
# `llm` (default) classifies natural phrasings with the provider above, so you never have
# to say "ask TONY to ...". With the `echo` provider it short-circuits to the deterministic
# keyword router, so offline/dev behaviour is unchanged until a real model is configured.
# An explicit "ask <agent> to ..." always wins, and any model error falls back to keywords.
# `keyword` pins the deterministic router even when a real model IS configured.
# NOTE: with `llm` and a HOSTED provider, the utterance of every request that does not name
# an agent is sent to that provider to pick the agent -- including requests that then go to
# a local-only agent (FRIDAY/TONY/NATASHA/WONG/JARVIS). Use `keyword`, or a local Ollama
# base URL, if routing must not leave the machine.
JARVIS_ROUTER=llm                   # llm | keyword
# The routing call runs before the agent's own and answers with one agent id, so it has its
# own small budget: a stalled provider cannot hold up the reply for the full LLM timeout.
JARVIS_ROUTER_TIMEOUT_SECONDS=5
JARVIS_ROUTER_MAX_TOKENS=16

# ---- search (SHURI research) --------------------------------------------------------
# Default `none` disables web search (dev/tests): SHURI then honestly says it found nothing.
# `duckduckgo`/`generic` talk to a DuckDuckGo-shaped JSON endpoint. DuckDuckGo's Instant Answer
# API is keyless and HTTPS, so it works with only the two lines below. (Other engines with a
# different JSON shape, e.g. SearxNG, need a parser branch in core/search.py:_parse first.) A
# non-none provider with an empty base URL safely falls back to disabled. On any network/parse
# error the provider returns no results (never fabricated) -- it never crashes an /assist
# request and never logs the query or key. A remote http:// base URL is a prod fail-closed
# error (the query would travel in cleartext); loopback http:// (a local engine) is allowed.
JARVIS_SEARCH_PROVIDER=none         # none (disabled) | duckduckgo | generic
# DuckDuckGo: https://api.duckduckgo.com/   (the only JSON shape parsed today)
JARVIS_SEARCH_BASE_URL=
# Optional; DuckDuckGo needs none. Sent as a Bearer header for a keyed engine.
JARVIS_SEARCH_API_KEY=
JARVIS_SEARCH_TIMEOUT_SECONDS=10
JARVIS_SEARCH_MAX_RESULTS=5

# ---- scheduler ----------------------------------------------------------------------
# true: this process runs cron jobs (single-process dev). Set false on API replicas and run
# `python -m jarvis_backend worker` as the ONE scheduler.
JARVIS_RUN_SCHEDULER=true

# ---- docker compose only (consumed by docker-compose.yml, not by the app) ---------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
