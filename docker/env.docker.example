# Settings for docker-compose.yml. Copy to  docker/.env.docker  (git-ignored) and edit.
# This is deliberately NOT the project-root .env: that one is read by `python -m jarvis_backend`
# when you run it directly, and the two need different origins.
#
# NO secrets belong here. Passwords and keys live in ./secrets/* (see make_docker_secrets.py).

# ---- LOCAL laptop test (plain http, no domain) -------------------------------------
JARVIS_ENV=dev
JARVIS_ALLOWED_HOSTS=localhost,127.0.0.1
JARVIS_PUBLIC_ORIGIN=http://localhost:8080
JARVIS_HTTP_PORT=8080
TZ=UTC

# ---- REAL deployment: replace the block above with this -----------------------------
# JARVIS_ENV=prod                                  # refuses to start on any unsafe setting
# JARVIS_ALLOWED_HOSTS=jarvis.example.com
# JARVIS_PUBLIC_ORIGIN=https://jarvis.example.com  # must be https; TLS is terminated in front of nginx
# JARVIS_HTTP_PORT=8080
# JARVIS_DATABASE_SSL=prefer                       # use verify-full if Postgres is not in this stack
