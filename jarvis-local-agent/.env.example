# =====================================================================================
# JARVIS local agent (the Windows voice runtime). Copy to `.env` (git-ignored).
# Safe to commit; `.env` is not.
#
# Register this PC:  Dashboard > System > Local agents > Register device
#   (or: python -m jarvis_backend create-device --name "My PC")
# Then store the credentials in the Windows Credential Manager (recommended):
#   python -m jarvis_local_agent.credentials set
# and leave JARVIS_DEVICE_SECRET out of this file entirely.
# =====================================================================================

# Remote backends MUST be https:// (the agent refuses to send credentials over plain http
# to anything but this machine).
JARVIS_BACKEND_URL=http://127.0.0.1:8077

JARVIS_DEVICE_ID=
JARVIS_DEVICE_SECRET=               # prefer Credential Manager over putting this here

# What the agent may ever touch on this PC. The backend can NOT widen these lists.
JARVIS_ALLOWED_PATHS=C:\Users\you\projects
JARVIS_ALLOWED_APPS=notepad,code,explorer,chrome,msedge

JARVIS_WAKE_PHRASE=hey jarvis
JARVIS_WAKE_SENSITIVITY=0.5
JARVIS_CONVERSATION_TIMEOUT_S=12
JARVIS_LOG_LEVEL=INFO

# Offline Vosk speech model. Leave the path empty to use the bundled language code; set it
# to a downloaded model directory (https://alphacephei.com/vosk/models) for another language.
JARVIS_VOSK_MODEL_LANG=en-us
JARVIS_VOSK_MODEL_PATH=            # empty = use lang; else a path to an unzipped model dir
# Prefer a specific Windows SAPI voice (substring of its name/id/language). Empty keeps the
# default english david/zira selection.
JARVIS_TTS_VOICE_HINT=
